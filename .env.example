# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign session cookies (generate a long random string)
SESSION_SECRET=replace-with-a-long-random-string

# Storage bucket name used for question diagrams/images
SUPABASE_STORAGE_BUCKET=agora-quiz-media

# Public site URL (used to build quiz links). Set to your EdgeOne domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
